# ==============================================================================
# ReFlow Platform Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Web App: apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: privileged server-side access. When unset, server routes fall back
# to the anon key and rely on Row-Level Security.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. ReFlow Runner Daemon Configuration (Engine: packages/engine)
# ------------------------------------------------------------------------------
# Base URL of the ReFlow Web Control Plane (default: http://localhost:3000)
REFLOW_CLOUD_URL=http://localhost:3000

# Organization Runner Bearer Token, issued when pairing a runner in the dashboard.
# Format: rf_live_<16hex_org>_<32hex_secret>
REFLOW_RUNNER_TOKEN=rf_live_0123456789abcdef_0123456789abcdef0123456789abcdef

# Directory where downloaded files and workflow artifacts are saved
# (default: the OS downloads folder)
REFLOW_TARGET_FOLDER=

# The Chrome DevTools Protocol port is not configured here. Pass --port to the
# engine CLI (default 9222); the desktop worker pins the same port.
